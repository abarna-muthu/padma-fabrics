# ===================================================================
# Padma Fabrics / Padmanabha Artisan Shop — Environment Configuration
# ===================================================================

# Server Port
PORT=5000
NODE_ENV=development

# JWT Secret for Admin & Customer Authentication
# (Generate a secure random string for production, e.g. using `openssl rand -hex 32`)
JWT_SECRET=padma_fabrics_secure_jwt_token_development_key_9940145700
JWT_EXPIRES_IN=7d

# -------------------------------------------------------------------
# Database Configuration (MySQL / TiDB Cloud compatible)
# -------------------------------------------------------------------
# If DB_HOST is omitted, the server automatically starts with the
# embedded in-memory development engine pre-seeded with all catalog items.
#
# For TiDB Cloud Serverless or standard MySQL 8.0+:
# DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_USER=your_tidb_username.root
# DB_PASSWORD=your_tidb_password
# DB_NAME=padma_fabrics
# DB_SSL=true

# Alternative direct connection string:
# DATABASE_URL=mysql://user:password@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/padma_fabrics?ssl={"rejectUnauthorized":true}

# -------------------------------------------------------------------
# Initial Admin Provisioning (Used solely on initial DB migration)
# -------------------------------------------------------------------
# INITIAL_ADMIN_EMAIL=admin@gmail.com
# INITIAL_ADMIN_PASSWORD=admin123
# INITIAL_ADMIN_NAME=Padmanabha Administrator

# -------------------------------------------------------------------
# CORS Configuration
# -------------------------------------------------------------------
CLIENT_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# -------------------------------------------------------------------
# Cloudinary Image Storage Configuration
# -------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=ugzb1wup
CLOUDINARY_API_KEY=533229489928217
CLOUDINARY_API_SECRET=-TBIKsMTQf0a6p1BYLBeVtHS6Fg
CLOUDINARY_FOLDER=padma_products

# -------------------------------------------------------------------
